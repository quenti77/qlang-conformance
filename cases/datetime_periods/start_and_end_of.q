let t = datetime.of(2026, 11, 4, 15, 30, 20)
print(t.start_of_hour())
print(t.end_of_hour())
print(t.end_of_day())
print(t.start_of_week())
print(t.end_of_week())
print(t.start_of_month())
print(t.end_of_month())
print(t.start_of_quarter())
print(t.end_of_quarter())
print(t.start_of_year())
print(t.end_of_year())
