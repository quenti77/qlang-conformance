print(Path.base("/a/b.txt"))
print(Path.dir("/a/b.txt"))
print(Path.dir("b.txt"))
print(Path.ext("a.tar.gz"))
print(Path.stem("a.tar.gz"))
print(Path.ext(".bashrc"))
print(Path.with_ext("a/b.txt", "md"))
print(Path.with_ext("a/b.txt", ""))
print(Path.is_absolute("/a"))
print(Path.is_absolute("a"))
print(Path.matches("src/**/*.q", "src/a/b/c.q"))
print(Path.matches("src/*.q", "src/a/b.q"))
