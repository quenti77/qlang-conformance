let paris = Zone.of("Europe/Paris").unwrap()
let summer = datetime.of(2026, 7, 1, 12, 0, 0)
let winter = datetime.of(2026, 1, 1, 12, 0, 0)
print(paris.format(summer, "YYYY-MM-DD HH:mm"))
print(paris.abbreviation(summer))
print(paris.offset_seconds(summer))
print(paris.offset_seconds(winter))
print(paris.abbreviation(winter))
print(paris.wall(summer).hour())
print(paris.local(2026, 10, 11, 9, 0, 0).to_iso())
print(paris.local(2026, 3, 29, 2, 30, 0).to_iso())
print(Zone.of("Nowhere/Land").is_err())
