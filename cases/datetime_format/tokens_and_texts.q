let t = datetime.of(2026, 3, 9, 16, 5, 6)
print(t.format("dddd D MMMM YYYY [à] h:mm A"))
print(t.format("ddd D MMM YY, HH:mm:ss.SSS"))
print(t.format("[on] WW/YYYY"))
print(t.format_in("dddd D MMMM YYYY", "fr"))
print(t.day_of_year())
print(t.week())
print(datetime.of(2024, 12, 30).week_year())
print(t.to_http())
print(t.to_rfc2822())
print(t.unix())
print(datetime.at(-1).unix())
